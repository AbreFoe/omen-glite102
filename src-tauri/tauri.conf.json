{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GLite",
  "version": "0.1.0",
  "identifier": "dev.glite.mouse",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GLite",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "create": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
